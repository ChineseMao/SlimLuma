<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld 个</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lldটি</string><key>other</key><string>%lldটি</string></dict></dict>
	<key>%lld 个失败</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lldটি ব্যর্থতা</string><key>other</key><string>%lldটি ব্যর্থতা</string></dict></dict>
	<key>%lld 个说明章节</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lldটি ব্যাখ্যা বিভাগ</string><key>other</key><string>%lldটি ব্যাখ্যা বিভাগ</string></dict></dict>
	<key>%lld 个未变小但已保留</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lldটি ফল ছোট হয়নি, তবু রাখা হয়েছে</string><key>other</key><string>%lldটি ফল ছোট হয়নি, তবু রাখা হয়েছে</string></dict></dict>
	<key>%lld 个未生成</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lldটি ফাইল তৈরি হয়নি</string><key>other</key><string>%lldটি ফাইল তৈরি হয়নি</string></dict></dict>
	<key>%lld 个文件，可继续拖入</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lldটি ফাইল; আরও ফাইল টেনে আনতে পারেন</string><key>other</key><string>%lldটি ফাইল; আরও ফাইল টেনে আনতে পারেন</string></dict></dict>
	<key>%lld 个已生成</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lldটি ফাইল তৈরি হয়েছে</string><key>other</key><string>%lldটি ফাইল তৈরি হয়েছে</string></dict></dict>
	<key>还有 %lld 个引擎可补齐</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lldটি ইঞ্জিন এখনও যোগ করা বাকি</string><key>other</key><string>%lldটি ইঞ্জিন এখনও যোগ করা বাকি</string></dict></dict>
	<key>同时处理 %lld 个任务</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lldটি কাজ একসঙ্গে প্রক্রিয়া করুন</string><key>other</key><string>%lldটি কাজ একসঙ্গে প্রক্রিয়া করুন</string></dict></dict>
</dict>
</plist>
