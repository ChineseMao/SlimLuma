<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld 个</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lld</string>
			<key>other</key><string>%lld 個</string>
		</dict>
	</dict>
	<key>%lld 个失败</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lld</string>
			<key>other</key><string>%lld 個失敗項目</string>
		</dict>
	</dict>
	<key>%lld 个说明章节</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lld</string>
			<key>other</key><string>%lld 個說明章節</string>
		</dict>
	</dict>
	<key>%lld 个未变小但已保留</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lld</string>
			<key>other</key><string>%lld 個未縮小但已保留</string>
		</dict>
	</dict>
	<key>%lld 个未生成</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lld</string>
			<key>other</key><string>%lld 個未產生</string>
		</dict>
	</dict>
	<key>%lld 个文件，可继续拖入</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lld</string>
			<key>other</key><string>%lld 個檔案，可繼續拖入</string>
		</dict>
	</dict>
	<key>%lld 个已生成</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lld</string>
			<key>other</key><string>%lld 個已產生</string>
		</dict>
	</dict>
	<key>还有 %lld 个引擎可补齐</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lld</string>
			<key>other</key><string>還有 %lld 個引擎可補齊</string>
		</dict>
	</dict>
	<key>同时处理 %lld 个任务</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lld</string>
			<key>other</key><string>同時處理 %lld 個工作</string>
		</dict>
	</dict>
</dict>
</plist>
