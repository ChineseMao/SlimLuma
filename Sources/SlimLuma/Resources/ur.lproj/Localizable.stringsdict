<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld 个</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld</string><key>other</key><string>%lld</string></dict></dict>
	<key>%lld 个失败</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld ناکامی</string><key>other</key><string>%lld ناکامیاں</string></dict></dict>
	<key>%lld 个说明章节</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld وضاحتی حصہ</string><key>other</key><string>%lld وضاحتی حصے</string></dict></dict>
	<key>%lld 个未变小但已保留</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld نتیجہ چھوٹا نہیں ہوا مگر محفوظ رکھا گیا</string><key>other</key><string>%lld نتائج چھوٹے نہیں ہوئے مگر محفوظ رکھے گئے</string></dict></dict>
	<key>%lld 个未生成</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld فائل نہیں بنائی گئی</string><key>other</key><string>%lld فائلیں نہیں بنائی گئیں</string></dict></dict>
	<key>%lld 个文件，可继续拖入</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld فائل، مزید فائلیں یہاں گھسیٹ سکتے ہیں</string><key>other</key><string>%lld فائلیں، مزید فائلیں یہاں گھسیٹ سکتے ہیں</string></dict></dict>
	<key>%lld 个已生成</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld فائل بنائی گئی</string><key>other</key><string>%lld فائلیں بنائی گئیں</string></dict></dict>
	<key>还有 %lld 个引擎可补齐</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>مزید %lld انجن شامل کرنا باقی ہے</string><key>other</key><string>مزید %lld انجن شامل کرنے باقی ہیں</string></dict></dict>
	<key>同时处理 %lld 个任务</key>
	<dict><key>NSStringLocalizedFormatKey</key><string>%#@count@</string><key>count</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld کام ایک وقت میں چلائیں</string><key>other</key><string>%lld کام ایک وقت میں چلائیں</string></dict></dict>
</dict>
</plist>
