<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld 个</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld آئٹم</string>
			<key>other</key>
			<string>%lld آئٹماں</string>
		</dict>
	</dict>
	<key>%lld 个失败</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ناکامی</string>
			<key>other</key>
			<string>%lld ناکامیاں</string>
		</dict>
	</dict>
	<key>%lld 个说明章节</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld وضاحت والا حصہ</string>
			<key>other</key>
			<string>%lld وضاحت والے حصے</string>
		</dict>
	</dict>
	<key>%lld 个未变小但已保留</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld نتیجہ چھوٹا نہیں ہویا پر رکھ لیا گیا</string>
			<key>other</key>
			<string>%lld نتیجے چھوٹے نہیں ہوئے پر رکھ لئے گئے</string>
		</dict>
	</dict>
	<key>%lld 个未生成</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld فائل نہیں بنی</string>
			<key>other</key>
			<string>%lld فائلاں نہیں بنیاں</string>
		</dict>
	</dict>
	<key>%lld 个文件，可继续拖入</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld فائل، ہور فائلاں ایتھے کھچ سکدے او</string>
			<key>other</key>
			<string>%lld فائلاں، ہور فائلاں ایتھے کھچ سکدے او</string>
		</dict>
	</dict>
	<key>%lld 个已生成</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld فائل بن گئی</string>
			<key>other</key>
			<string>%lld فائلاں بن گئیاں</string>
		</dict>
	</dict>
	<key>还有 %lld 个引擎可补齐</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ہور %lld انجن شامل کرنا باقی اے</string>
			<key>other</key>
			<string>ہور %lld انجن شامل کرنے باقی نیں</string>
		</dict>
	</dict>
	<key>同时处理 %lld 个任务</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>اکّو ویلے %lld ٹاسک چلاؤ</string>
			<key>other</key>
			<string>اکّو ویلے %lld ٹاسکاں چلاؤ</string>
		</dict>
	</dict>
</dict>
</plist>
